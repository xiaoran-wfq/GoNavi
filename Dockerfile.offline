# Stage 1: Frontend Build
FROM node:20-alpine AS frontend-builder
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build

# Stage 2: Backend Build & Driver Pre-build
FROM golang:1.24-alpine AS backend-builder
RUN apk add --no-cache gcc musl-dev bash
WORKDIR /app
ENV GOPROXY=https://mirrors.aliyun.com/goproxy/,direct
COPY go.mod go.sum ./
COPY third_party/ ./third_party/
RUN go mod download
COPY . .
COPY --from=frontend-builder /app/frontend/dist ./frontend/dist

# Multi-arch support via buildx args
ARG TARGETOS
ARG TARGETARCH

# 1. Build the main application
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o gonavi .

# 2. Build all optional driver agents for the target architecture
# Using the project's build-driver-agents.sh script
# We build them into a specific directory structure that the app expects
RUN chmod +x build-driver-agents.sh && \
    ./build-driver-agents.sh --platform ${TARGETOS}/${TARGETARCH} --out-dir ./prebuilt_drivers

# Stage 3: Final Image
FROM alpine:latest
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=backend-builder /app/gonavi .

# Copy pre-built drivers into the data directory
# The app expects drivers in data/drivers/<driver_name>/<os>/<arch>/...
# We copy the entire prebuilt_drivers folder content
COPY --from=backend-builder /app/prebuilt_drivers ./data/drivers

VOLUME /app/data
ENV GONAVI_WEB=true
EXPOSE 8080

ENTRYPOINT ["./gonavi"]
CMD ["--port", "8080"]
